# 应用配置
PORT=3000
NODE_ENV=development

# 对外端口（由 caddy 容器发布，Basic Auth 鉴权后再转发 frontend）
# 共享服务器上 8080 等常用端口可能已被其他租户占用，部署前先用 ss -tlnp 确认空闲
FRONTEND_PORT=18080

# Caddy Basic Auth 凭据不放在 .env：bcrypt 哈希中的 $ 会被 compose 插值截断
# 改为编辑 auth.caddy（模板见 auth.caddy.example，init-env 脚本会自动复制）

# MySQL 数据库配置
# 容器化部署时 DB_HOST/DB_PORT/DB_USERNAME 由 docker-compose.yml 覆盖，此处无需修改
# 仅本地开发模式（npm run start:dev）使用下面的 localhost 连接
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
# 建议运行 scripts/init-env.ps1 / init-env.sh 自动生成随机密码（与 MySQL 容器共用）
DB_PASSWORD=
DB_DATABASE=library_seat

# Redis 配置
# 容器化部署时 REDIS_HOST/REDIS_PORT 由 docker-compose.yml 覆盖
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ 配置
BULLMQ_PREFIX=library-seat

# 通知模式：mock | wxpusher
# mock：打日志 + 写 notifications 表；wxpusher：WxPusher Topic 广播推送到微信
NOTIFY_MODE=mock

# WxPusher 微信推送（NOTIFY_MODE=wxpusher 时生效）
# appToken / topicId 在 WxPusher 后台获取，Topic 创建与订阅二维码为后台一次性操作
WXPUSHER_APP_TOKEN=
WXPUSHER_TOPIC_ID=

# 图书馆 API 基地址
LIBRARY_API_BASE_URL=https://hdu.huitu.zhishulib.com

# 图书馆座位消息转发
# 总开关：true 启用 / false 停用（默认 true，改动后重启进程生效，无需改代码）
MESSAGE_FORWARD_ENABLED=true
# 轮询间隔（毫秒，默认 120000 = 2 分钟）
MESSAGE_FORWARD_INTERVAL_MS=120000

# CAS 统一认证登录凭据
CAS_USERNAME=
CAS_PASSWORD=
CAS_SERVICE=https://hdu.huitu.zhishulib.com/User/Index/hduCASLogin?forward=%2FSpace%2FCategory%2Flist%3Fcategory_id%3D591

# 账号密码加密密钥（AES-256-GCM，32 字节）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未配置时应用启动会 fail-fast 终止，不会降级使用明文兜底
ACCOUNT_SECRET_KEY=