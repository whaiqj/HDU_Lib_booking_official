# 对外唯一入口：Basic Auth 鉴权后转发 frontend 容器
# 凭据放在 auth.caddy（git 忽略，不入库），由 import 原样导入：
# 不能走环境变量传入——bcrypt 哈希形如 $2a$14$xxx，其中的 $ 会被
# docker compose 的变量插值静默截断（实测容器只收到 $2a$14），Basic Auth 失效
:80 {
	# 导入 /etc/caddy/auth.caddy（由 compose 只读挂载 ./auth.caddy），内容形如：
	#   basic_auth {
	#       你的用户名 $2a$14$...完整哈希...
	#   }
	import /etc/caddy/auth.caddy

	# 静态页面与后端 API 全部转给 frontend 容器（nginx 继续负责静态/API 分流）
	# 前端请求均为相对路径，API 流量同样经过这里，一并被鉴权覆盖
	reverse_proxy frontend:80
}
